<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- rounded-square background with a subtle Tokyo Night gradient -->
    <path android:pathData="M24,10 H84 A14,14 0 0 1 98,24 V84 A14,14 0 0 1 84,98 H24 A14,14 0 0 1 10,84 V24 A14,14 0 0 1 24,10 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="10" android:startY="10"
                android:endX="98" android:endY="98">
                <item android:offset="0" android:color="#FF24283B" />
                <item android:offset="1" android:color="#FF16161E" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- accent hairline frame -->
    <path
        android:pathData="M24,11.5 H84 A12.5,12.5 0 0 1 96.5,24 V84 A12.5,12.5 0 0 1 84,96.5 H24 A12.5,12.5 0 0 1 11.5,84 V24 A12.5,12.5 0 0 1 24,11.5 Z"
        android:strokeColor="#337AA2F7"
        android:strokeWidth="1.5"
        android:fillColor="#00000000" />

    <!-- prompt chevron '>' -->
    <path
        android:pathData="M36,40 L52,54 L36,68"
        android:strokeColor="#FF9ECE6A"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- cursor underscore '_' -->
    <path
        android:pathData="M58,64 H76 V71 H58 Z"
        android:fillColor="#FF7AA2F7" />
</vector>
